# =============================================
# content-hub 环境变量模板
# 用法：cp .env.example .env 后填入真实值
# 注意：真实 .env 已 gitignore，请勿提交密钥
# =============================================

# ---------- MySQL ----------
MYSQL_HOST=127.0.0.1
MYSQL_PORT=4833
MYSQL_USER=root
MYSQL_ROOT_PWD=your_mysql_password
MYSQL_DB=content_hub

# ---------- Redis ----------
REDIS_HOST=127.0.0.1
REDIS_PORT=8943
REDIS_PASSWORD=your_redis_password

# ---------- Qdrant 向量库 ----------
QDRANT_HOST=127.0.0.1
QDRANT_PORT=6433
QDRANT_GRPC_PORT=6434

# ---------- RabbitMQ 消息队列 ----------
RABBITMQ_HOST=127.0.0.1
RABBITMQ_PORT=5673
RABBITMQ_MANAGEMENT_PORT=15673
RABBITMQ_DEFAULT_USER=content_admin
RABBITMQ_DEFAULT_PASS=your_rabbitmq_password
RABBITMQ_QUEUE_DOCUMENT_PARSE=content_document_parse
RABBITMQ_QUEUE_ARTICLE_GENERATE=content_article_generate

# ---------- JWT ----------
JWT_SECRET=change-me-to-a-secret
JWT_EXPIRE_SECONDS=86400

# ---------- LLM（对话，DeepSeek） ----------
LLM_API_KEY=your_deepseek_api_key
LLM_BASE_URL=https://api.deepseek.com
LLM_CHAT_MODEL=deepseek-v4-flash
# 单次 LLM 调用的基础超时(秒)。注意：客户端会按请求体大小自动追加推理余量，
# 大 prompt(写作/事实校验)不会再被固定死在这个基础值内。若想进一步放宽可调大此值。
LLM_TIMEOUT_SECONDS=120
LLM_MAX_RETRY=3

# ---------- LLM Embedding（硅基流动） ----------
LLM_EMBED_API_KEY=your_siliconflow_api_key
LLM_EMBED_BASE_URL=https://api.siliconflow.cn/v1
LLM_EMBEDDING_MODEL=Qwen/Qwen3-VL-Embedding-8B

# ---------- 阿里云 OSS ----------
OSS_REGION=cn-shenzhen
OSS_ENDPOINT=oss-cn-shenzhen.aliyuncs.com
OSS_ACCESS_KEY_ID=your_oss_access_key_id
OSS_ACCESS_KEY_SECRET=your_oss_access_key_secret
OSS_BUCKET=my-content-hub

# ---------- Server ----------
SERVER_HTTP_PORT=8181

# ---------- 日志 ----------
LOG_LEVEL=info
LOG_FILE=/tmp/content-hub-log/content-hub.log

# ---------- 切块策略 ----------
CHUNK_STRATEGY=structured
CHUNK_SIZE=300
CHUNK_OVERLAP=0

# ---------- 检索 ----------
KBE_TOP_K=20
# 检索相似度阈值：低于该分数的命中判为不相关，直接丢弃（防止低相关噪声当成证据、避免 AI 编造数据）
KBE_MIN_SCORE=0.6

# ---------- 检索质量升级（P14，默认全关 = 保持纯向量检索现状） ----------
# 排序策略：dense（默认，纯向量）| hybrid（BM25+向量，RRF 融合）| hybrid_rerank（再叠加 Rerank 精排）
RETRIEVAL_STRATEGY=dense
# 混合检索候选池大小（先向量召回 top N，再在池内算 BM25 + RRF）
RETRIEVAL_HYBRID_K=50
# RRF 融合参数 k
RETRIEVAL_RRF_K=60
# BM25 参数 k1 / b
RETRIEVAL_BM25_K1=1.2
RETRIEVAL_BM25_B=0.75
# 重排序只精排前 N 个候选；模型名；base_url/api_key 留空则回落 Embedding 段（硅基流动）
RETRIEVAL_RERANK_TOP_N=20
RETRIEVAL_RERANK_MODEL=BAAI/bge-reranker-v2-m3
RETRIEVAL_RERANK_BASE_URL=
RETRIEVAL_RERANK_API_KEY=
# Guardian 首轮检索前用 LLM 把 claim 扩展为多个 query（默认关）
RETRIEVAL_QUERY_EXPAND=0
RETRIEVAL_QUERY_EXPAND_COUNT=3

# ---------- 数据挂载根目录 ----------
DATA_ROOT=/absolute/path/to/content-hub-data

# ---------- 限流（Redis 滑动窗口） ----------
RL_TENANT_PER_MIN=120
RL_USER_PER_MIN=60
RL_NOTE_PER_MIN=20
RL_WINDOW_SEC=60
RL_KEY_TTL_SEC=120
